{
  "name": "redmine-mcpb",
  "version": "1.0.0",
  "private": true,
  "description": "Redmine MCP server packaged as a Claude Desktop extension (.mcpb)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StockLin/redmine-mcpb.git"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && mcpb validate manifest.json && mcpb pack . redmine.mcpb",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node server/index.mjs",
    "release": "node scripts/release.mjs",
    "test": "npm run build && node scripts/test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
